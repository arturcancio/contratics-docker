# ==============================================================================
# Contratics Environment Configuration (Supabase Self-Hosted + Docker)
# ==============================================================================

# Ports configuration
WEB_PORT=3000
API_PORT=8000
STUDIO_PORT=8001
POSTGRES_PORT=5432

# Database configuration
POSTGRES_PASSWORD=your_super_secret_postgres_password_here
POSTGRES_DB=postgres
POSTGRES_USER=postgres

# Security & JWT Tokens
JWT_SECRET=your_super_secret_jwt_token_with_at_least_32_characters_long
ANON_KEY=your_supabase_anon_jwt_token_here
SERVICE_ROLE_KEY=your_supabase_service_role_jwt_token_here
REALTIME_ENC_KEY=your_16_char_enc_key_here
REALTIME_SECRET_KEY_BASE=your_64_char_secret_key_base_here

# Frontend Public Variables
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here
