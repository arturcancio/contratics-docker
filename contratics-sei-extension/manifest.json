{
  "manifest_version": 3,
  "name": "Contratics SEI Studio — Varredura Geral & Fluxo BPMN 2.0",
  "version": "1.0.0",
  "description": "Extensão oficial do Contratics (SOF/MPO) inspirada no Estúdio de Fluxo do SEI Pro para varredura geral de processos no SEI, espelhamento automático no Fluxo BPMN 2.0, processos associados e rollback.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.gov.br/*",
    "http://localhost:*/*",
    "https://localhost:*/*",
    "*://*.vercel.app/*",
    "*://*.netlify.app/*",
    "*://*.run.app/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Contratics SEI Studio"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-contratics.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.gov.br/sei/*",
        "*://sei.economia.gov.br/*",
        "*://sei.fazenda.gov.br/*",
        "*://sei.planejamento.gov.br/*",
        "*://colaboragov.sei.gov.br/*"
      ],
      "js": ["content-sei.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
